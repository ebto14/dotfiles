{
    "layer": "top",
    "position": "top",
    "height": 32,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    // MÁRGENES: Esto despega la barra de los bordes (Arriba, Derecha, Abajo, Izquierda)
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "margin-bottom": 0,

    // ORDEN CORRECTO: Con la sintaxis "custom/nombre"
    "modules-left": ["custom/menu", "hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "bluetooth",
        "network",
        "custom/mi_script1", // Corregido también por si acaso
        "clock",
        "tray",
        "custom/power"
    ],

    // MENÚ DE APPS A LA IZQUIERDA
    "custom/menu": {
        "format": "󰣇",
        "on-click": "/home/ebto/.config/rofi/launchers/misc/launcher.sh",
        "tooltip": false
    },

    // CONTROL DE ESCRITORIOS: Lógica nativa para Hyprland (Tu Pacman-Ricing)
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "format-icons": {
            "active": "󰮯",      // Pac-Man amarillo (actual)
            "occupied": "󰊠",    // Fantasma (con ventanas abiertas)
            "default": "",     // Punto relleno (vacío)
            "urgent": "󰊠"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "separate-outputs": true
    },

    "cpu": {
        "interval": 10,
        "format": "  {usage}%"
    },

    "memory": {
        "interval": 30,
        "format": "  {used:0.1f}G"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "  Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "bluetooth": {
        "format": " On",
        "format-disabled": "󰂲 Off",
        "format-connected": " {num_connections}",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
        "on-click-right": "blueman-manager",
        "tooltip": false
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  Connected",
        "format-disconnected": "󰖪  Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-right": "nm-connection-editor"
    },

    "custom/mi_script1": {
        "exec": "~/.config/waybar/scripts/mi_script1.sh",
        "interval": 5,
        "format": "{}"
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A, %B %d, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 10
    },

    // BOTÓN DE APAGADO A LA DERECHA
    "custom/power": {
        "format": "⏻",
        "on-click": "/home/ebto/.config/rofi/powermenu/type-2/powermenu.sh",
        "tooltip": false
    }
}
