{
    "layer": "top",
    "position": "top",
    "height": 32,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "margin-bottom": 0,

    "modules-left": ["custom/menu", "hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "bluetooth",
        "network",
        "clock",
        "custom/power"
    ],

    "custom/menu": {
        "format": "󰣇",
        "on-click": "/home/ebto/.config/rofi/launchers/misc/launcher.sh",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "show-special": true,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": []
        },
        "format": "{icon}",
        "format-icons": {
            "active": "󰮯",      // Ícono de Pacman nativo
            "empty": "",    // Ícono del Fantasma nativo
            "default": "󰊠"      // Ícono del Círculo para los vacíos
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "separate-outputs": true
    },

    "cpu": {
        "interval": 10,
        "format": "  {usage}%"
    },

    "memory": {
        "interval": 30,
        "format": "  {used:0.1f}G"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "  Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "bluetooth": {
        "format": " On",
        "format-disabled": "󰂲 Off",
        "format-connected": " {num_connections}",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
        "on-click-right": "blueman-manager",
        "tooltip": false
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  Connected",
        "format-disconnected": "󰖪  Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-right": "nm-connection-editor"
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A, %B %d, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "/home/ebto/.config/rofi/powermenu/type-2/powermenu.sh",
        "tooltip": false
    }
}
