{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,

    // Lista de módulos organizados por bloques
    "modules-left": ["custom/logo", "hyprland/workspaces"],
    "modules-center": ["cpu", "memory"],
    "modules-right": ["tray", "bluetooth", "network", "pulseaudio", "clock", "custom/power"],

    // --- CONFIGURACIÓN DE MÓDULOS ---

    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "show-special": true,
        "persistent-workspaces": {
            "*": 4 // Muestra de forma persistente los escritorios del 1 al 4 en cualquier monitor
        },
        "format": "{icon}",
        "format-icons": {
            "active": "󰮯",
            "empty": "",
            "default": "󰊠",
            "urgent": "󰵚"
        }
    },

    "cpu": {
        "interval": 2, // 2 segundos es más óptimo para no generar hilos innecesarios en el i7
        "format": "󰍛 {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 3,
        "format": " {percentage}%",
        "tooltip": true,
        "tooltip-format": "RAM Usada: {used:0.1f}GiB / {total:0.1f}GiB"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "clock": {
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format": "  {:%H:%M}",
        "format-alt": " {:%a, %d %b %Y}"
    },

    "network": {
        "format-ethernet": "󰈀   {bandwidthDownBits}  {bandwidthUpBits}",
        "format-wifi": "{icon}   {bandwidthDownBits}  {bandwidthUpBits}",
        "format-disconnected": "󰤭  0Kbps",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format": "Interfaz: {ifname}\nIP: {ipaddr}\nSubida total: {bandwidthUpBytes}\nBajada total: {bandwidthDownBytes}",
        "interval": 2, // Actualiza cada 2 segundos para medir bien la velocidad sin saturar el sistema
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-disabled": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
        "on-click-right": "~/.config/waybar/scripts/bluetooth-scan.sh"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Mute",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "Dispositivo: {desc}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle", // Actualizado a wireplumber
        "on-click-right": "pavucontrol"
    },

    "custom/logo": {
        "format": "  ",
        "on-click": "/home/ebto/.config/rofi/launchers/misc/launcher.sh" // Sincronizado con tu bind de hyprland.conf
    },

    "custom/power": {
        "format": "󰤆",
        "on-click": "/home/ebto/.config/rofi/powermenu/type-2/powermenu.sh" // Sincronizado con tu atajo de salida rápida
    }
}
